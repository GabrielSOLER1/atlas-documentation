{
  "name": "atlas/portail-documentaire",
  "description": "Atlas Documentation — internal knowledge portal",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "config": {
    "allow-plugins": {"symfony/runtime": true},
    "sort-packages": true
  }
}
